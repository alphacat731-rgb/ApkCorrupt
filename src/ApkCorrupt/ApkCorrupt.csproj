<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ApkCorrupt</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>APK Corrupt</ApplicationTitle>
    <ApplicationId>com.alphacat.apkcorrupt</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- .NET 10 enables marshal-method generation by default; disabling it
         avoids known startup crashes/hangs on affected Android devices. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>

    <!-- CI artifacts are installed directly, not through Fast Deployment.
         Keep all managed assemblies inside the APK. -->
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

    <!-- Prefer a reliable standalone APK while we stabilize the app. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <AndroidMavenLibrary Include="com.android.tools.build:apksig"
                         Version="8.13.0"
                         Repository="Google"
                         Bind="false" />
    <AndroidMavenLibrary Include="com.github.iyxan23:zipalign-java"
                         Version="1.2.2"
                         Repository="https://jitpack.io"
                         Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <AndroidJavaSource Include="Platforms\Android\Java\ApkSignerBridge.java" />
  </ItemGroup>

</Project>
